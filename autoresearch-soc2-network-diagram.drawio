        <mxCell id="store_research" value="&lt;b&gt;research/&lt;/b&gt;&#xa;&#xa;Plans + findings&#xa;(human-edited&#xa;review gate)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFECB3;strokeColor=#FF8F00;fontSize=9;verticalAlign=top;spacingTop=6;" vertex="1" parent="boundary">
