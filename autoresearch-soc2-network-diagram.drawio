        <mxCell id="title" value="&lt;b&gt;Parallel Autoresearch CLI — Network Architecture &amp;amp; Data Flow (SOC 2)&lt;/b&gt;" style="text;html=1;fontSize=20;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="10" width="1520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="System boundary = operator workstation (local CLI)  |  No cloud infrastructure operated by this system  |  External egress: OpenRouter + optional Palantir Foundry" style="text;html=1;fontSize=13;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="50" width="1520" height="30" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=0;startSize=25;fillColor=#F5F5F5;strokeColor=#424242;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="560" height="330" as="geometry" />
        </mxCell>
        <mxCell id="leg_content" value="&lt;b&gt;Edge colors&lt;/b&gt;&#xa;&#xa;&lt;font color=&quot;#2E7D32&quot;&gt;━━ Green&lt;/font&gt; = Local process / IPC (never leaves workstation)&#xa;&lt;font color=&quot;#C62828&quot;&gt;━━ Red&lt;/font&gt; = External HTTPS API call (may carry project / customer data)&#xa;&lt;font color=&quot;#E65100&quot;&gt;━━ Orange&lt;/font&gt; = Local data persistence (filesystem writes/reads)&#xa;&lt;font color=&quot;#6A1B9A&quot;&gt;━━ Purple&lt;/font&gt; = Logging / observability&#xa;&lt;font color=&quot;#757575&quot;&gt;- - Gray dashed&lt;/font&gt; = Operational (installs, dependencies — no customer data)&#xa;&#xa;&lt;b&gt;Encryption&lt;/b&gt;&#xa;In transit: all external calls HTTPS / TLS 1.2+&#xa;At rest: workstation full-disk encryption (FileVault / OS-managed)&#xa;&#xa;&lt;b&gt;Not applicable (no cloud infra operated by this system)&lt;/b&gt;&#xa;AWS Org/account, Region, VPC, subnets, AZs, IGW/NAT,&#xa;ALB/WAF/CloudFront, security groups, KMS, CloudTrail/GuardDuty" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=5;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="540" height="290" as="geometry" />
        </mxCell>

        <mxCell id="boundary" value="SOC 2 System Boundary — Operator Workstation (macOS / Linux)&#xa;&lt;i style=&quot;font-size:10px&quot;&gt;All compute local (Python 3.12 + uv)  |  Disk encrypted (OS-managed)  |  Secrets in .env, never committed&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=0;startSize=42;fillColor=#FFF8E1;strokeColor=#FF8F00;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
