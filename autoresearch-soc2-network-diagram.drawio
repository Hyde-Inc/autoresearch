        </mxCell>
        <mxCell id="evaluator" value="&lt;b&gt;Protected Evaluator&lt;/b&gt;&#xa;Train / validation / hidden-holdout&#xa;split + final promotion gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="cli">
