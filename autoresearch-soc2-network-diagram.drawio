        </mxCell>
        <mxCell id="store_tasks" value="&lt;b&gt;tasks/ + .autoresearch/&lt;/b&gt;&#xa;&#xa;task.yaml, survey.md,&#xa;train split (agent-visible)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFECB3;strokeColor=#FF8F00;fontSize=9;verticalAlign=top;spacingTop=6;" vertex="1" parent="boundary">
          <mxGeometry x="580" y="660" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="store_sealed" value="&lt;b&gt;Sealed actuals&lt;/b&gt;&#xa;&#xa;Validation + hidden&#xa;holdout — never copied&#xa;to agent worktrees;&#xa;agents have no read path" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;verticalAlign=top;spacingTop=6;" vertex="1" parent="boundary">
          <mxGeometry x="860" y="660" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="store_env" value="&lt;b&gt;.env secrets&lt;/b&gt;&#xa;&#xa;OPENROUTER_API_KEY&#xa;FOUNDRY_TOKEN&#xa;(git-ignored)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=9;verticalAlign=top;spacingTop=6;" vertex="1" parent="boundary">
          <mxGeometry x="1150" y="660" width="250" height="140" as="geometry" />
        </mxCell>

        <mxCell id="scope_notes" value="&lt;b&gt;SOC 2 scope notes&lt;/b&gt;&#xa;&#xa;• &lt;b&gt;System boundary:&lt;/b&gt; this CLI and its local artifacts on the operator workstation. No servers, VPCs, subnets, AZs, load balancers, WAF, or KMS are operated by this system (N/A). No dev/staging environments exist; the bundled demo/ project (synthetic data) is out of scope.&#xa;• &lt;b&gt;Admin access path:&lt;/b&gt; engineer → local terminal → CLI. No SSH, no remote administrative surface, no listening ports.&#xa;• &lt;b&gt;Data protection:&lt;/b&gt; validation + hidden-holdout actuals are sealed outside agent worktrees; agents may only edit solution/; raw project data is never copied into worktrees; holdout scored only at the final gate.&#xa;• &lt;b&gt;Logging / monitoring:&lt;/b&gt; per-agent JSONL logs, run state.json, per-token cost ledger with --max-cost budget cap.&#xa;• &lt;b&gt;Backup / recovery:&lt;/b&gt; every agent session is snapshot-committed to git; the research/ notebook is committed with the project repo.&#xa;• &lt;b&gt;Documented control for untrusted models:&lt;/b&gt; run inside a container or VM (README guidance)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="boundary">
          <mxGeometry x="40" y="880" width="1400" height="260" as="geometry" />
        </mxCell>

        <mxCell id="or_plane" value="OpenRouter (LLM API Gateway — subservice organization)&#xa;&lt;i style=&quot;font-size:10px&quot;&gt;HTTPS TLS 1.2+  |  Bearer API key  |  Spend metered per token&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=0;startSize=42;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1600" y="430" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="or_api" value="&lt;b&gt;openrouter.ai/api/v1&lt;/b&gt;&#xa;Chat completions (director, agents, metric grader)&#xa;GET /key — doctor credit check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C62828;fontSize=10;" vertex="1" parent="or_plane">
          <mxGeometry x="30" y="50" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="or_providers" value="Routes to downstream model providers (Anthropic, OpenAI, Google, …) per model choice — sub-subservice organizations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=9;fontStyle=2;" vertex="1" parent="or_plane">
          <mxGeometry x="30" y="155" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="or_note" value="Prompts may include project data samples and code. Retention governed by OpenRouter / provider policies — review for SOC 2 vendor management." style="text;html=1;fontSize=9;fontStyle=2;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="or_plane">
          <mxGeometry x="30" y="225" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fd_plane" value="Palantir Foundry (optional runtime — customer-controlled)&#xa;&lt;i style=&quot;font-size:10px&quot;&gt;HTTPS  |  Bearer FOUNDRY_TOKEN  |  scopes: datasets-read/write, orchestration-write&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;rounded=0;startSize=42;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1600" y="780" width="560" height="300" as="geometry" />
        </mxCell>
        <mxCell id="fd_datasets" value="&lt;b&gt;Datasets API&lt;/b&gt;&#xa;readTable (ingest, sealed-actuals readback), file upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="fd_plane">
          <mxGeometry x="30" y="50" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fd_repos" value="&lt;b&gt;Code Repos + Orchestration&lt;/b&gt;&#xa;Per-experiment branches, transform builds on Foundry compute; winner merged to master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;" vertex="1" parent="fd_plane">
