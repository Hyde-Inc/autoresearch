          <mxGeometry x="20" y="120" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="agent2" value="&lt;b&gt;Agent #2&lt;/b&gt;&#xa;git worktree&#xa;build → train → evaluate&#xa;snapshot commits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0288D1;fontSize=9;" vertex="1" parent="agents">
